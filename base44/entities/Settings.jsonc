{
  "name": "Settings",
  "type": "object",
  "properties": {
    "teacher_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05d5\u05e8\u05d4"
    },
    "my_phone": {
      "type": "string",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d4\u05d8\u05dc\u05e4\u05d5\u05df \u05e9\u05dc\u05d9"
    },
    "default_lesson_price": {
      "type": "number",
      "description": "\u05de\u05d7\u05d9\u05e8 \u05e9\u05d9\u05e2\u05d5\u05e8 \u05e8\u05d2\u05d9\u05dc"
    },
    "price_image_url": {
      "type": "string",
      "description": "\u05ea\u05de\u05d5\u05e0\u05ea \u05de\u05d7\u05d9\u05e8\u05d5\u05df"
    },
    "flyer_images": {
      "type": "array",
      "description": "\u05ea\u05de\u05d5\u05e0\u05d5\u05ea \u05e4\u05dc\u05d9\u05d9\u05e8",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "whatsapp_student_template": {
      "type": "string",
      "description": "\u05ea\u05d1\u05e0\u05d9\u05ea \u05ea\u05d6\u05db\u05d5\u05e8\u05ea \u05dc\u05e9\u05d9\u05e2\u05d5\u05e8 - \u05ea\u05dc\u05de\u05d9\u05d3\u05d9\u05dd \u05d1\u05d5\u05d2\u05e8\u05d9\u05dd",
      "default": "\u05d4\u05d9\u05d9 {name}! \u05ea\u05d6\u05db\u05d5\u05e8\u05ea \u05dc\u05e9\u05d9\u05e2\u05d5\u05e8 \u05e9\u05dc\u05e0\u05d5 \u05d4\u05d9\u05d5\u05dd \u05d1{time} \ud83c\udfb8"
    },
    "whatsapp_parent_template": {
      "type": "string",
      "description": "\u05ea\u05d1\u05e0\u05d9\u05ea \u05ea\u05d6\u05db\u05d5\u05e8\u05ea \u05dc\u05e9\u05d9\u05e2\u05d5\u05e8 - \u05d4\u05d5\u05e8\u05d9\u05dd",
      "default": "\u05d4\u05d9\u05d9 {parent}, \u05d4\u05d9\u05d5\u05dd \u05d1{time} \u05e9\u05d9\u05e2\u05d5\u05e8 \u05dc{name}. \ud83c\udfb5 \u05d9\u05ea\u05e8\u05ea \u05e9\u05d9\u05e2\u05d5\u05e8\u05d9\u05dd: {balance}"
    },
    "whatsapp_renewal_template": {
      "type": "string",
      "description": "\u05ea\u05d1\u05e0\u05d9\u05ea \u05d7\u05d9\u05d3\u05d5\u05e9 \u05db\u05e8\u05d8\u05d9\u05e1\u05d9\u05d4 - \u05ea\u05dc\u05de\u05d9\u05d3\u05d9\u05dd \u05d1\u05d5\u05d2\u05e8\u05d9\u05dd",
      "default": "\u05d4\u05d9\u05d9 {name}! \ud83c\udfb8 \u05d4\u05db\u05e8\u05d8\u05d9\u05e1\u05d9\u05d9\u05d4 \u05e9\u05dc\u05da \u05e2\u05d5\u05de\u05d3\u05ea \u05dc\u05d4\u05e1\u05ea\u05d9\u05d9\u05dd (\u05e0\u05d5\u05ea\u05e8\u05d5 {balance} \u05e9\u05d9\u05e2\u05d5\u05e8\u05d9\u05dd). \u05e0\u05e9\u05de\u05d7 \u05dc\u05d7\u05d3\u05e9 \u05d0\u05d5\u05ea\u05da!"
    },
    "whatsapp_parent_renewal_template": {
      "type": "string",
      "description": "\u05ea\u05d1\u05e0\u05d9\u05ea \u05d7\u05d9\u05d3\u05d5\u05e9 \u05db\u05e8\u05d8\u05d9\u05e1\u05d9\u05d4 - \u05d4\u05d5\u05e8\u05d9\u05dd",
      "default": "\u05d4\u05d9\u05d9 {parent}! \ud83c\udfb8 \u05d4\u05db\u05e8\u05d8\u05d9\u05e1\u05d9\u05d9\u05d4 \u05e9\u05dc {name} \u05e2\u05d5\u05de\u05d3\u05ea \u05dc\u05d4\u05e1\u05ea\u05d9\u05d9\u05dd (\u05e0\u05d5\u05ea\u05e8\u05d5 {balance} \u05e9\u05d9\u05e2\u05d5\u05e8\u05d9\u05dd). \u05e0\u05e9\u05de\u05d7 \u05dc\u05d7\u05d3\u05e9!"
    },
    "motd": {
      "type": "string",
      "description": "\u05d4\u05d5\u05d3\u05e2\u05d4 \u05d0\u05d9\u05e9\u05d9\u05ea \u05d1\u05d3\u05e9\u05d1\u05d5\u05e8\u05d3"
    },
    "notify_before_lesson": {
      "type": "boolean",
      "description": "\u05d4\u05ea\u05e8\u05d0\u05d4 15 \u05d3\u05e7' \u05dc\u05e4\u05e0\u05d9 \u05e9\u05d9\u05e2\u05d5\u05e8"
    }
  },
  "required": []
}