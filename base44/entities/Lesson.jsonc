        "\u05d1\u05d5\u05e6\u05e2",
        "\u05d1\u05d5\u05d8\u05dc"
      ],
      "default": "\u05e2\u05ea\u05d9\u05d3\u05d9",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1"
    },
    "summary": {
      "type": "string",
      "description": "\u05e1\u05d9\u05db\u05d5\u05dd \u05e9\u05d9\u05e2\u05d5\u05e8"
